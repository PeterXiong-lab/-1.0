name: Auto Build EXE

# 这里补齐了触发条件：当你推代码，或者想手动点按钮时，就会开始打包
on:
  push:
    branches: [ "main" ]  # 每次你向 main 分支提交代码时自动打包
  workflow_dispatch:       # 允许你在网页上随时手动点击按钮打包

jobs:
  build:
    runs-on: windows-latest  # 让 GitHub 给你开一台 Windows 电脑来打包

    steps:
    - name: 1. 签出代码
      uses: actions/checkout@v4

    - name: 2. 安装 Python 环境
      uses: actions/setup-python@v5
      with:
        python-version: '3.10' # 你的 Python 版本，也可以改成 3.11 或 3.12

    - name: 3. 安装依赖和 PyInstaller
      run: |
        python -m pip install --upgrade pip
        pip install pyinstaller
        # 💡 注意：如果你的代码里引用了第三方库（比如 requests），请取消下面这一行的注释并修改：
        # pip install requests

    - name: 4. 开始打包
      run: |
        # 💡 请把下面的 main.py 改成你实际的 Python 文件名！
        pyinstaller -F main.py 

    - name: 5. 将打包好的 EXE 发布到网页供下载
      uses: actions/upload-artifact@v4
      with:
        name: My_Compiled_EXE  # 网页上显示的下载包名称
        path: dist/*.exe       # 自动抓取 dist 文件夹下的 exe 文件
